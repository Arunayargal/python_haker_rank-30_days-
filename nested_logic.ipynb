   "source": [
    "d1, m1, y1 = map(int, input().split())\n",
    "d2, m2, y2 = map(int, input().split())\n",
    "\n",
    "if y1 > y2:\n",
    "    fine = 10000\n",
    "elif y1 == y2 and m1 > m2:\n",
    "    fine = 500 * (m1 - m2)\n",
    "elif y1 == y2 and m1 == m2 and d1 > d2:\n",
    "    fine = 15 * (d1 - d2)\n",
    "else:\n",
    "    fine = 0\n",
    "\n",
    "print(fine)"
   ]
  }
 ],
